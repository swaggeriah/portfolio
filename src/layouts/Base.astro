---
import '../styles/global.css';
import { site } from '../site.config';
import { url } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = `${site.name}: ${site.tagline}` } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="taskbar">
      <div class="taskbar-inner">
        <a class="btn start" href={url('/')}>{site.name}</a>
        <nav>
          <a class="btn" href={url('/#projects')}>Projects</a>
          <a class="btn" href={url('/#key-points')}>Key points</a>
          <a class="btn" href={url('/#contact')}>Contact</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="statusbar">
      <div class="statusbar-inner">
        <span class="cell">© {new Date().getFullYear()} {site.name}</span>
      </div>
    </footer>
  </body>
</html>