---
// Draws the list of layout blocks from a project or entry file.
// The drawing itself lives in src/lib/render.ts, which the editor's live preview uses too.
import type { Block } from '../lib/blocks';
import { renderMarkdown } from '../lib/markdown';
import { renderBlocks } from '../lib/render';
import { publicUrl } from '../lib/content';

interface Props {
  blocks: Block[];
}

const { blocks } = Astro.props;

// Block text is Markdown, converted once per block here.
const textHtml = await Promise.all(
  blocks.map((block) => (block.type === 'content' && block.text ? renderMarkdown(block.text) : '')),
);
const html = renderBlocks(blocks, { resolve: publicUrl, textHtml });
---

<Fragment set:html={html} />
