---
// Loose pictures placed on a block. Which layer they sit on is picked with `layer`.
import type { Decoration } from '../lib/blocks';
import { decorationStyle, publicUrl } from '../lib/style';

interface Props {
  items: Decoration[];
  layer: 'behind' | 'middle' | 'front';
}

const { items, layer } = Astro.props;
const shown = items.filter((deco) => deco.image && deco.layer === layer);
---

{
  shown.map((deco) => (
    <img
      class={`deco deco-${layer}`}
      src={publicUrl(deco.image!)}
      alt=""
      aria-hidden="true"
      loading="lazy"
      style={decorationStyle(deco)}
    />
  ))
}
