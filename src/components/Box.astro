---
// A backdrop: the box that sits behind a block or behind its text.
// The look comes from classes and CSS variables in global.css.
import type { BoxStyle } from '../lib/blocks';
import { boxStyle, styleString } from '../lib/style';

interface Props {
  box: BoxStyle;
  class?: string;
  extra?: Record<string, string | number | undefined>;
}

const { box, class: className, extra = {} } = Astro.props;
const style = styleString({ ...boxStyle(box), ...extra });
---

<div class:list={['box', `bd-${box.backdrop}`, className]} style={style}>
  {box.backdrop === 'window' && <div class="title-bar">{box.title}</div>}
  <div class="box-inner">
    <slot />
  </div>
</div>
