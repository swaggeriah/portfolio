---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Window from '../../../components/Window.astro';
import { getProjects, getEntries, formatDate, url } from '../../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  const entries = await getEntries();
  return entries.map((entry) => ({
    params: { project: entry.projectId, entry: entry.slug },
    props: {
      entry,
      project: projects.find((project) => project.id === entry.projectId)!,
    },
  }));
}

const { entry, project } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <nav class="crumbs narrow">
    <a class="btn" href={url('/')}>Home</a>
    <a class="btn" href={url(`/projects/${project.id}/`)}>{project.data.title}</a>
    <span class="cell">{entry.data.category}</span>
  </nav>

  <Window title={entry.data.title} heading="h1" narrow>
    <p class="meta">{formatDate(entry.data.date)} · {entry.data.category}</p>
    <article class="prose panel">
      <Content />
    </article>
    {
      entry.data.keyPoints.length > 0 && (
        <ul class="tags">
          {entry.data.keyPoints.map((point) => <li>{point}</li>)}
        </ul>
      )
    }
  </Window>
</Base>